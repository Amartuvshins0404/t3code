# Optional: T3 Connect source builds
# `cp .env.example .env` builds against the self-hosted T3 Connect stack. These
# are public URLs, not secrets, and builds use the same values when unset.
# Do not add server-side secrets to this file.

# Better Auth service (infra/auth) and relay (infra/relay).
T3CODE_AUTH_URL=https://auth.amartuvshin.com
T3CODE_RELAY_URL=https://relay.amartuvshin.com

# Mobile still signs in with Clerk until it moves to the auth service.
T3CODE_CLERK_PUBLISHABLE_KEY=pk_live_Y2xlcmsudDMuY29kZXMk
T3CODE_CLERK_JWT_TEMPLATE=t3-relay

# Optional: signed macOS passkey builds.
# T3CODE_APPLE_TEAM_ID=ABC1234567
# T3CODE_MACOS_PROVISIONING_PROFILE=/absolute/path/to/t3code.provisionprofile
# T3CODE_PASSKEY_RP_DOMAINS=amartuvshin.com

# Optional: hosted app origin for agent sign-in approvals.
# Defaults to https://app.t3.codes; override to test against a staging deployment.
# T3CODE_HOSTED_APP_URL=https://nightly.app.t3.codes

# Optional: owner branding. The name pre-fills the Welcome page and names the
# built app ("<name> Mode"). The app shows plain "Mode" when it is unset.
# T3CODE_OWNER_NAME=Amaraa
# A PNG or JPEG for every app icon, absolute or relative to the repo root.
# Non-square images are centre-cropped. Run `vp run icons:export` after setting
# or changing it; icons go to the gitignored .owner-icons/ folder and builds use
# them instead of the committed placeholder.
# T3CODE_OWNER_LOGO=/absolute/path/to/logo.png

# Public, ingest-only mobile OpenTelemetry configuration.
# T3CODE_MOBILE_OTLP_TRACES_URL=https://api.axiom.co/v1/traces
# T3CODE_MOBILE_OTLP_TRACES_DATASET=t3-code-mobile-traces-dev
# T3CODE_MOBILE_OTLP_TRACES_TOKEN=xaat-...
